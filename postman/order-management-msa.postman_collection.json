{
  "info": {
    "name": "order-management-msa — JWT flow",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "gateway_url", "value": "http://localhost:8080" },
    { "key": "token", "value": "" }
  ],
  "item": [
    {
      "name": "1. Register user (via gateway)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"testuser\",\n  \"email\": \"testuser@example.com\",\n  \"password\": \"Password123\",\n  \"role\": \"ADMIN\"\n}"
        },
        "url": {
          "raw": "{{gateway_url}}/users",
          "host": ["{{gateway_url}}"],
          "path": ["users"]
        }
      }
    },
    {
      "name": "2. Login (via gateway)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const body = pm.response.json();",
              "if (body && body.data && body.data.token) {",
              "    pm.collectionVariables.set('token', body.data.token);",
              "    console.log('Saved token to {{token}}');",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"testuser\",\n  \"password\": \"Password123\"\n}"
        },
        "url": {
          "raw": "{{gateway_url}}/auth/login",
          "host": ["{{gateway_url}}"],
          "path": ["auth", "login"]
        }
      }
    },
    {
      "name": "3. GET /users — no token (expect 401 from gateway)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{gateway_url}}/users",
          "host": ["{{gateway_url}}"],
          "path": ["users"]
        }
      }
    },
    {
      "name": "4. GET /users — garbage token (expect 401 from gateway)",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer garbage.token.here" }
        ],
        "url": {
          "raw": "{{gateway_url}}/users",
          "host": ["{{gateway_url}}"],
          "path": ["users"]
        }
      }
    },
    {
      "name": "5. GET /users — valid token (expect 200 with data)",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": {
          "raw": "{{gateway_url}}/users",
          "host": ["{{gateway_url}}"],
          "path": ["users"]
        }
      }
    }
  ]
}
